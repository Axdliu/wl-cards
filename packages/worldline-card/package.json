{
  "name": "worldline-card",
  "version": "0.1.0",
  "description": "Composable collectible / trading-card UI for React Native — tilt, holo shine, stat layouts",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "react-native",
    "trading-card",
    "collectible",
    "tcg",
    "pokemon",
    "holographic",
    "tilt",
    "reanimated",
    "mobile"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Axdliu/wl-cards.git",
    "directory": "packages/worldline-card"
  },
  "bugs": {
    "url": "https://github.com/Axdliu/wl-cards/issues"
  },
  "homepage": "https://github.com/Axdliu/wl-cards#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-gesture-handler": ">=2.14.0",
    "react-native-reanimated": ">=3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.30.2",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
